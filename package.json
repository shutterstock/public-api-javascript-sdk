{
  "name": "@shutterstock/public-api-typescript-sdk",
  "version": "1.6.0",
  "packageManager": "pnpm@11.20.0",
  "description": "The Shutterstock API provides access to Shutterstock's library of media as well as information about customers accounts and the contributors that provide the media",
  "author": "OpenAPI-Generator Contributors",
  "keywords": [
    "shutterstock"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc --outDir dist/",
    "prepublishOnly": "npm run build",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts",
    "lint:fix": "pnpm run lint -- --fix",
    "test:integration": "./node_modules/mocha/bin/mocha --recursive"
  },
  "devDependencies": {
    "superagent": "^5.0.2",
    "chai": "^4.2.0",
    "eslint": "^8.16.0",
    "mocha": "^6.1.4",
    "sinon": "1.17.3",
    "uuid": "^3.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^4.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "node",
    "testRegex": "(\\.|/)(test|spec)\\.tsx?$",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended"
    ],
    "env": {
      "es2021": true,
      "node": true,
      "jest": true
    },
    "ignorePatterns": [
      "dist/"
    ],
    "rules": {
      "no-empty-pattern": "off",
      "no-redeclare": "off",
      "no-undef": "off",
      "no-unused-vars": "off"
    }
  },
  "resolutions": {
    "*/**/js-yaml": "^3.13.1",
    "*/**/lodash": "^4.17.21",
    "*/**/yargs-parser": "^20.2.7",
    "*/**/minimist": "^1.2.5",
    "*/**/acorn": "^8.1.0"
  }
}
